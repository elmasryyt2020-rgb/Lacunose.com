# ============================================================
# Lacunose backend — environment variables
# Copy to .env on the VPS, chmod 600, never commit.
# ============================================================

# --- LLM provider (swap target for post-hackathon) ---
# anthropic          = Opus synth + Haiku map/critique (production hackathon config)
# anthropic-allopus  = Opus everywhere (demo surface for "Built with 4.7" judging)
# deepseek           = DeepSeek V4 synth + V3.2 map/critique (post-hackathon)
# mock               = deterministic fixtures (tests)
LLM_PROVIDER=anthropic

# Opus 4.7 / Haiku 4.5 concrete model IDs used by src/llm/router.ts.
# Override here if the Anthropic catalog advances — e.g. to a dated
# suffix like `claude-opus-4-7-20260310`. If either ID 404s on your
# key, a model-not-found error will blow up on the first analysis.
ANTHROPIC_OPUS_MODEL=claude-opus-4-7
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

COHERE_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=
POLITE_EMAIL=support@lacunose.com

# --- Supabase (self-hosted on this VPS) ---
SUPABASE_URL=https://api.lacunose.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres — used by workers for bulk ops & migrations
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Queue + cache ---
REDIS_URL=redis://localhost:6379

# --- Edge-fn server ---
EDGE_FN_PORT=4000
EDGE_FN_HOST=0.0.0.0

# --- PDF parser ---
PDF_PARSER=pymupdf
PYMUPDF_PY=/usr/bin/python3

# --- Zoho Mail for support bridge ---
SUPPORT_FROM_ADDRESS=support@lacunose.com
SUPPORT_STAFF_ADDRESS=team@lacunose.com
ZOHO_IMAP_HOST=imap.zoho.com
ZOHO_IMAP_PORT=993
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_USER=support@lacunose.com
ZOHO_APP_PASSWORD=
SUPPORT_POLL_INTERVAL_MS=30000

# --- Billing ---
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_TOKEN=

# --- Observability ---
SENTRY_DSN_BACKEND=
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_KEY_SERVER=

# --- Push notifications ---
EXPO_ACCESS_TOKEN=

# --- Limits ---
FREE_MONTHLY_ANALYSES=3
PRO_MONTHLY_ANALYSES=50
PREMIUM_MONTHLY_ANALYSES=150
MAX_ANALYSIS_TOKENS=500000
